# ── Copy to .env on the VPS, then edit values ─────────────────────────────────
# docker compose picks this up automatically when run from smart-dentalops/

# Database
POSTGRES_USER=dentalops
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dentalops

# Backend
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=https://your-domain.com

# Twilio (optional)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# Meta WhatsApp Cloud API (optional)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_VERIFY_TOKEN=
